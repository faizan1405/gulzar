# Database (MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>/<database-name>?retryWrites=true&w=majority"

# Allow empty-data fallback when the DB is unreachable (off in production)
ALLOW_DB_FALLBACK="false"

# Auth.js / NextAuth — Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-32-character-random-auth-secret"
NEXTAUTH_SECRET="your-32-character-random-auth-secret"

# Google OAuth Credentials
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# URLs
NEXTAUTH_URL="https://rishteforever.in"
NEXT_PUBLIC_SITE_URL="https://rishteforever.in"
NEXT_PUBLIC_ADMIN_URL="https://rishteforever.in/admin"

# Admin Panel — Google OAuth (primary)
ADMIN_ALLOWED_EMAILS="faizankhan1405@gmail.com"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# SMS — "REAL" enables a real provider; anything else uses mock SMS
SMS_PROVIDER="MOCK"

# Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_dummy_key_id"
RAZORPAY_KEY_SECRET="rzp_dummy_key_secret"
RAZORPAY_WEBHOOK_SECRET=""

# AI Chatbot
AI_CHATBOT_API_KEY=""
AI_CHATBOT_PROVIDER="gemini"
AI_CHATBOT_MODEL="gemini-1.5-flash"
